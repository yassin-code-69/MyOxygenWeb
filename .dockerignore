# Safety net for builds that use the repository root as context.
# docker-compose.yml builds with ./backend and ./frontend as contexts, which
# use their own .dockerignore files.

# --- Secrets: every env file except the committed templates ---
.env
.env.*
**/.env
**/.env.*
!**/.env.example

# --- VCS ---
.git
.github

# --- Dependencies & build output ---
**/node_modules
**/.next
**/out
**/dist
**/build
**/coverage
**/*.tsbuildinfo
**/*.log

# --- Local state ---
backend/.testdb
backend/uploads

# --- Tests ---
**/*.test.ts
**/*.test.tsx
backend/src/tests

# --- Agent tooling, specs and docs (not needed in images) ---
.agents
.claude
context
plans
docs
skills-lock.json
**/*.md
