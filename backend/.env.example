# ==========================================
# My Oxygen Backend - Production Environment Variables
# ==========================================

# Server Configuration
PORT=4000
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000

# Database Configuration (Supabase PostgreSQL)
# Pooled connection via Supavisor (Port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Direct connection for migrations (Port 5432)
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Authentication & Security
# Must be at least 32 characters long
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long

# Logistics & Courier Providers
# Steadfast Courier (Bangladesh)
STEADFAST_API_KEY=your_steadfast_api_key_here
STEADFAST_SECRET_KEY=your_steadfast_secret_key_here
STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1

# Notifications & Gateways
# SSL Wireless SMS Gateway (Bangladesh)
SSL_WIRELESS_API_TOKEN=your_ssl_wireless_token_here
SSL_WIRELESS_SID=your_approved_sender_id
SSL_WIRELESS_BASE_URL=https://smsplus.sslwireless.com/api/v3/send-sms

# Transactional Email (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="My Oxygen <orders@myoxygen.com>"
