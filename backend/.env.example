# ==========================================================
# My Oxygen — Backend environment template
# Copy to .env and fill in the values. Never commit real secrets.
# Validated at startup by src/env.ts: the API refuses to boot with a list of
# problems (values are never printed). Empty values count as "not set".
# Tests use .env.test instead (local database only).
# ==========================================================

# --- Server ---
# development | production | test
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins. "*" is rejected in production.
CORS_ORIGIN=http://localhost:3000
# Public storefront URL (used in emails / links). Optional.
FRONTEND_URL=http://localhost:3000
# Set to true ONLY when running behind a reverse proxy that sets X-Forwarded-For;
# otherwise clients could spoof their IP to bypass rate limiting.
TRUST_PROXY=false
# Header holding the client IP when TRUST_PROXY=true. "x-forwarded-for" (default)
# uses its right-most entry. On Railway set "x-real-ip": its edge overwrites that
# header, while the right-most X-Forwarded-For entry is one of its proxy hops.
# CLIENT_IP_HEADER=x-forwarded-for
# IANA zone used for business dates (expiry checks, nightly jobs).
APP_TIMEZONE=Asia/Dhaka

# --- Database (Supabase PostgreSQL) — REQUIRED ---
# Supabase Dashboard -> Connect. Use the Supavisor pooler hosts (IPv4); the
# direct db.<ref>.supabase.co host is IPv6-only on most networks.
# The "aws-N-" host prefix differs between Supabase projects: ALWAYS copy the
# exact host from the dashboard. For this project (ref trhxoqxbngqpexrhfvrh,
# region ap-southeast-1) it is aws-0-ap-southeast-1.pooler.supabase.com.
# URL-encode special characters in the password (e.g. "@" -> %40, "#" -> %23).
# App runtime: transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Migrations / drizzle-kit: session pooler (port 5432). Optional; falls back to DATABASE_URL.
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Max connections in the API's pool (1-100).
DB_POOL_MAX=10

# --- Auth — REQUIRED ---
# Min 32 chars (64 in production). Generate with: openssl rand -hex 64
JWT_SECRET=replace_with_output_of_openssl_rand_hex_64

# --- Background jobs (BullMQ) ---
# Optional. Without it, background work (nightly expiry scan, notifications)
# runs in-process. docker-compose.yml sets redis://redis:6379 automatically.
# REDIS_URL=redis://localhost:6379

# --- Courier ---
# steadfast | mock. Without Steadfast credentials the adapter runs in sandbox/mock mode.
COURIER_PROVIDER=steadfast
# STEADFAST_API_KEY=your_steadfast_api_key
# STEADFAST_SECRET_KEY=your_steadfast_secret_key
# STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1

# --- SMS: SSL Wireless (Bangladesh) ---
# SSL_WIRELESS_API_TOKEN=your_ssl_wireless_token
# SSL_WIRELESS_SID=your_approved_sender_id
# SSL_WIRELESS_BASE_URL=https://smsplus.sslwireless.com/api/v3/send-sms

# --- Email: Resend ---
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM=My Oxygen <orders@your-domain.com>
# Receives operational alerts (low stock, failed jobs).
# ADMIN_ALERT_EMAIL=ops@your-domain.com

# --- Seed (bun run db:seed) ---
# Super admin created by the seed. REQUIRED when NODE_ENV=production
# (password min 12 chars). In development they default to the documented
# dev credentials (see context/SPECIFICATION.md).
# SEED_ADMIN_EMAIL=admin@your-domain.com
# SEED_ADMIN_PASSWORD=choose_a_long_unique_password
# Seed the demo catalog (products, batches, sales, coupons). Unset = true outside
# production and false in production, where the seed creates only categories + the admin.
# SEED_DEMO_CATALOG=false
