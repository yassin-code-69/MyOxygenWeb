# ==========================================================
# My Oxygen — Backend TEST environment (committed, secret-free)
# Loaded automatically by `bun test` (NODE_ENV=test) and takes precedence
# over .env. Every database URL MUST point at localhost: the DB client and the
# test preload refuse to run otherwise.
# Start the throwaway cluster with: bun run test:db:up
# ==========================================================
NODE_ENV=test
PORT=4001
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://postgres@localhost:54329/my_oxygen_test
DIRECT_URL=postgresql://postgres@localhost:54329/my_oxygen_test
DB_POOL_MAX=10

# Dummy value for tests only (>= 64 chars). Never reuse it anywhere else.
JWT_SECRET=test-only-jwt-secret-not-for-production-0123456789abcdef0123456789abcdef

TRUST_PROXY=false
APP_TIMEZONE=Asia/Dhaka
COURIER_PROVIDER=mock

# Integrations stay in mock mode during tests: empty credentials override any
# values from .env and the providers treat them as "not configured".
REDIS_URL=
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
SSL_WIRELESS_API_TOKEN=
SSL_WIRELESS_SID=
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_ALERT_EMAIL=

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
