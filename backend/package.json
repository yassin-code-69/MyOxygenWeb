{
  "name": "my-oxygen-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "bun run scripts/test-db.ts up && bun test --timeout 15000",
    "test:db:up": "bun run scripts/test-db.ts up",
    "test:db:down": "bun run scripts/test-db.ts down",
    "test:db:reset": "bun run scripts/test-db.ts reset",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:check": "bun --bun drizzle-kit check",
    "db:seed": "bun src/db/seed.ts",
    "db:seed:demo-history": "bun scripts/seed-demo-history.ts",
    "db:studio": "bun --bun drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@hono/zod-validator": "^0.4.3",
    "bcryptjs": "^3.0.2",
    "bullmq": "^6.7.2",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.0",
    "hono": "^4.7.2",
    "jose": "^5.9.6",
    "node-cron": "^4.6.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "latest",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.7.3"
  }
}
