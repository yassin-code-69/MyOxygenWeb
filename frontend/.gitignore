# Frontend-specific ignores (the repository root .gitignore also applies).

# Dependencies
node_modules/
.pnp
.pnp.*

# Next.js build output and caches
.next/
out/
build/
dist/
*.tsbuildinfo
# Regenerated by `next dev` / `next build` / `next typegen` (differs between them)
next-env.d.ts

# Environment files are never committed: NEXT_PUBLIC_* values are inlined
# into the browser bundle and per-environment values belong in the deploy
# platform. Copy .env.example to .env.local for local development.
.env
.env.*
!.env.example

# Logs & debug reports
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Test coverage
coverage/
*.lcov

# Lint caches
.eslintcache
.stylelintcache

# Deployment platform state
.vercel

# OS
.DS_Store
Thumbs.db
