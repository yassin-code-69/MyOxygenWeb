{
  "name": "my-oxygen-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && bun run build:standalone-assets",
    "build:standalone-assets": "node -e \"const fs=require('node:fs');fs.cpSync('public','.next/standalone/public',{recursive:true});fs.cpSync('.next/static','.next/standalone/.next/static',{recursive:true});\"",
    "start": "node .next/standalone/server.js",
    "start:next": "next start",
    "lint": "oxlint -c oxlint.config.mjs .",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@mantine/carousel": "9.6.1",
    "@mantine/charts": "9.6.1",
    "@mantine/core": "9.6.1",
    "@mantine/dates": "9.6.1",
    "@mantine/form": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@mantine/notifications": "^9.6.2",
    "@mantine/spotlight": "9.6.1",
    "@tabler/icons-react": "^3.30.0",
    "dayjs": "^1.11.23",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "mantine-form-zod-resolver": "^1.3.0",
    "motion": "^13.4.0",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.10.1",
    "swr": "^2.5.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "24.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19.3.0",
    "oxc-config-mantine": "^1.0.3",
    "oxlint": "^1.85.0",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.7.3"
  }
}
