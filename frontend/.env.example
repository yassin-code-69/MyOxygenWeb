# ==========================================================
# My Oxygen — Frontend environment template
# Copy to .env.local for local development. Never commit real env files.
# ==========================================================

# Public origin of the backend API as seen from the BROWSER (no trailing slash).
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time:
# changing it requires a rebuild (Docker: --build-arg NEXT_PUBLIC_API_URL=...).
# Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:4000
